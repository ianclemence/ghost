{
  "agents": {
    "defaults": {
      "workspace": "~/ghost/workspace",
      "provider": "anthropic",
      "model": "claude-3.5-sonnet",
      "embedding_model": "nomic-embed-text",
      "max_tokens": 8192,
      "temperature": 0.7,
      "fallback_models": [],
      "fallback_cooldown_seconds": 30,
      "max_tool_iterations": 20,
      "restrict_to_workspace": true,
      "search_enabled": true,
      "session_store": "sqlite"
    },
    "routing": {
      "light_model": "",
      "threshold": 0.35
    },
    "model_list": [
      {
        "name": "local",
        "provider": "ollama",
        "model": "ollama/qwen3:4b"
      },
      {
        "name": "claude",
        "provider": "anthropic",
        "model": "claude-sonnet-4"
      },
      {
        "name": "gpt",
        "provider": "openai",
        "model": "gpt-4o"
      }
    ]
  },
  "gateway": {
    "host": "0.0.0.0",
    "port": 8766
  },
  "rag": {
    "enabled": true,
    "m": 16,
    "ef_construction": 200,
    "ef_search": 10
  },
  "providers": {
    "openrouter": {
      "api_base": "https://openrouter.ai/api/v1"
    },
    "zhipu": {
      "api_base": "https://open.bigmodel.cn/api/paas/v4"
    },
    "ollama": {
      "api_base": "http://localhost:11434"
    }
  },
  "channels": {
    "whatsapp": {
      "enabled": false,
      "bridge_url": "ws://localhost:3001",
      "allow_from": []
    },
    "telegram": {
      "enabled": true,
      "proxy": "",
      "allow_from": []
    },
    "discord": {
      "enabled": false,
      "allow_from": []
    },
    "slack": {
      "enabled": false,
      "allow_from": []
    },
    "line": {
      "enabled": false,
      "webhook_host": "0.0.0.0",
      "webhook_port": 18791,
      "webhook_path": "/webhook/line",
      "allow_from": []
    },
    "email": {
      "enabled": false,
      "smtp_host": "smtp.example.com",
      "smtp_port": 587,
      "allow_from": []
    },
    "sms": {
      "enabled": false,
      "allow_from": []
    },
    "wechat": {
      "enabled": false,
      "allow_from": []
    }
  },
  "tools": {
    "web": {
      "brave": {
        "enabled": false,
        "max_results": 5
      },
      "duckduckgo": {
        "enabled": true,
        "max_results": 5
      }
    },
    "mcp": {
      "enabled": false,
      "servers": {}
    },
    "curator": {
      "enabled": true,
      "stale_after_days": 30,
      "archive_after_days": 90,
      "check_interval_mins": 60
    },
    "delegation": {
      "enabled": true,
      "max_concurrent": 5,
      "max_tasks": 5,
      "budget_tokens": 100000
    }
  },
  "nudge": {
    "enabled": true,
    "memory_interval": 20,
    "skill_interval": 15
  },
  "personality": {
    "active": ""
  },
  "toolsets": {
    "active": ""
  },
  "devices": {
    "enabled": false,
    "monitor_usb": true
  },
  "skills": {
    "clawhub": {
      "base_url": "https://clawhub.ai",
      "timeout": 30
    }
  },
  "heartbeat": {
    "enabled": true,
    "interval": 30
  }
}
