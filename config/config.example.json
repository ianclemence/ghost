{
  "agents": {
    "defaults": {
      "workspace": "~/ghost/workspace",
      "provider": "anthropic",
      "model": "claude-3.5-sonnet",
      "embedding_model": "nomic-embed-text",
      "max_tokens": 8192,
      "temperature": 0.7,
      "fallback_models": ["ollama/qwen3.5:2b"],
      "fallback_cooldown_seconds": 30,
      "max_tool_iterations": 20,
      "restrict_to_workspace": true
    }
  },
  "rag": {
    "enabled": true
  },
  "providers": {
    "openrouter": {
      "api_base": "https://openrouter.ai/api/v1"
    },
    "zhipu": {
      "api_base": "https://open.bigmodel.cn/api/paas/v4"
    },
    "ollama": {
      "api_base": "http://localhost:11434"
    }
  },
  "channels": {
    "whatsapp": {
      "enabled": false,
      "bridge_url": "ws://localhost:3001",
      "allow_from": []
    },
    "telegram": {
      "enabled": true,
      "allow_from": []
    },
    "discord": {
      "enabled": false,
      "allow_from": []
    },
    "slack": {
      "enabled": false,
      "allow_from": []
    },
    "line": {
      "enabled": false,
      "webhook_port": 18791,
      "webhook_path": "/webhook/line",
      "allow_from": []
    },
    "email": {
      "enabled": false,
      "smtp_host": "smtp.example.com",
      "smtp_port": 587,
      "allow_from": []
    }
  },
  "tools": {
    "web": {
      "brave": {
        "enabled": false,
        "max_results": 5
      },
      "duckduckgo": {
        "enabled": true,
        "max_results": 5
      }
    }
  },
  "heartbeat": {
    "enabled": true,
    "interval": 30
  }
}
