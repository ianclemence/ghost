      "spec": {
        "kind": "present", "title": "Nairobi today",
        "blocks": [
          { "type": "metric", "label": "Now", "value": "24", "unit": "°C", "delta": "+2° vs yesterday", "tone": "good" },
          { "type": "facts", "rows": [ { "label": "Rain", "value": "10%" }, { "label": "Wind", "value": "12 km/h", "tone": "neutral" } ] },
          { "type": "note", "text": "Dry until the evening.", "tone": "info" }
        ]
      },
      "blocks": 3
    },
    {
      "name": "flight with a timeline and a choice",
      "spec": {
        "kind": "present", "title": "TP 1352",
        "blocks": [
          { "type": "timeline", "steps": [
            { "time": "09:40", "title": "Depart Lisbon", "state": "done" },
            { "time": "11:05", "title": "Land Nairobi", "detail": "Terminal 1A", "state": "now" },
            { "time": "12:00", "title": "Pick up bags", "state": "next" }
          ] },
          { "type": "progress", "label": "Flight", "progress": 0.6, "caption": "1h 10m left" }
        ],
        "actions": [
          { "id": "a1", "label": "Track it", "kind": "reply", "text": "Keep an eye on TP 1352 for me", "style": "primary" },
          { "id": "a2", "label": "Not now", "kind": "dismiss" }
        ]
      },
      "blocks": 2
    },
    {
      "name": "list and code",
      "spec": {
        "kind": "present", "title": "Three options",
        "blocks": [
          { "type": "list", "items": [ { "title": "Cafe Brera", "subtitle": "Near the station", "trailing": "$$", "tone": "good" }, { "title": "Diner 54" } ] },
          { "type": "code", "language": "bash", "code": "ghost routines add \"check flights\"" },
          { "type": "text", "text": "Say the word and I will book one." }
        ]
      },
      "blocks": 3
    }
  ],
  "invalid": [
