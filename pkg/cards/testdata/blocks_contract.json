    { "name": "unknown block type", "spec": { "kind": "present", "title": "x", "blocks": [ { "type": "iframe", "text": "hi" } ] } },
    { "name": "empty text", "spec": { "kind": "present", "title": "x", "blocks": [ { "type": "text", "text": "  " } ] } },
    { "name": "bad tone", "spec": { "kind": "present", "title": "x", "blocks": [ { "type": "note", "text": "hi", "tone": "rainbow" } ] } },
    { "name": "progress out of range", "spec": { "kind": "present", "title": "x", "blocks": [ { "type": "progress", "label": "p", "progress": 1.5 } ] } },
    { "name": "progress missing", "spec": { "kind": "present", "title": "x", "blocks": [ { "type": "progress", "label": "p" } ] } },
    { "name": "too many blocks", "spec": { "kind": "present", "title": "x", "blocks": [ {"type":"text","text":"1"},{"type":"text","text":"2"},{"type":"text","text":"3"},{"type":"text","text":"4"},{"type":"text","text":"5"},{"type":"text","text":"6"},{"type":"text","text":"7"},{"type":"text","text":"8"},{"type":"text","text":"9"} ] } },
    { "name": "bad timeline state", "spec": { "kind": "present", "title": "x", "blocks": [ { "type": "timeline", "steps": [ { "title": "a", "state": "later" } ] } ] } },
