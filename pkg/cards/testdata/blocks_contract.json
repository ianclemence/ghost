    { "name": "data on a block card", "spec": { "kind": "present", "title": "x", "data": { "a": "b" }, "blocks": [ { "type": "text", "text": "hi" } ] } },
    { "name": "unknown field", "spec": { "kind": "present", "title": "x", "html": "<b>hi</b>", "blocks": [ { "type": "text", "text": "hi" } ] } }
