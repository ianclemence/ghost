[Unit]
Description=Ghost Mobile Bridge
Documentation=https://github.com/your/ghost
After=network.target ghost.service
Wants=ghost.service

[Service]
Type=simple
User=ianclemence
WorkingDirectory=/home/ianclemence/ghost/bridge
EnvironmentFile=/home/ianclemence/ghost/.env
Environment="BRIDGE_PORT=8765"
Environment="GHOST_DB_PATH=/home/ianclemence/ghost/workspace/ghost.db"
Environment="MEMORY_DIR=/home/ianclemence/ghost/workspace/memory"
ExecStart=/home/ianclemence/ghost/bridge/ghost-bridge
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ghost-bridge
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
