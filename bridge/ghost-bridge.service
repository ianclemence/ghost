[Unit]
Description=Ghost Mobile Bridge
After=network.target ghost.service
Wants=ghost.service

[Service]
Type=simple
User=ianclemence
WorkingDirectory=/home/ianclemence/ghost/bridge

# No EnvironmentFile here — the Go binary loads .env itself from ../ghost/.env
# This avoids systemd injecting empty values that block .env loading.
ExecStart=/home/ianclemence/ghost/bridge/ghost-bridge
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ghost-bridge
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
