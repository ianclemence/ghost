[Unit]
Description=Ghost Local Speech Sidecar (whisper-server, loopback only)
After=network-online.target
Wants=network-online.target
ConditionPathExists=__MODELS_DIR__/active.ggml.bin

[Service]
Type=simple
User=root
Restart=always
RestartSec=5
WorkingDirectory=/tmp
ExecStart=__BIN_DIR__/whisper-server --host 127.0.0.1 --port __PORT__ -m __MODELS_DIR__/active.ggml.bin -t 4 --inference-path /v1/audio/transcriptions --convert
ReadWritePaths=__MODELS_DIR__

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ghost-speech

[Install]
WantedBy=multi-user.target
