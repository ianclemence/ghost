# ── Ghost Configuration ────────────────
GHOST_AGENTS_DEFAULTS_WORKSPACE=~/ghost/workspace
GHOST_CONFIG_DIR=config

# ── LLM Provider (Primary: Ollama) ──────
# Set Ollama as the default provider for Pi/Edge
GHOST_AGENTS_DEFAULTS_PROVIDER=ollama
GHOST_AGENTS_DEFAULTS_MODEL=qwen3.5:0.8b
GHOST_AGENTS_DEFAULTS_EMBEDDING_MODEL=nomic-embed-text # Suggest model for RAG with Ollama
GHOST_PROVIDERS_OLLAMA_API_BASE=http://localhost:11434

# ── Cloud LLM Providers (Optional) ──────
# KIMI_API_KEY=
# OPENROUTER_API_KEY=sk-or-v1-xxx
# ANTHROPIC_API_KEY=sk-ant-xxx
# OPENAI_API_KEY=sk-xxx
# GEMINI_API_KEY=xxx

# ── Chat Channels ───────────────────────
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_USER_ID=
# DISCORD_BOT_TOKEN=xxx

# ── Web Search (optional) ────────────────
# BRAVE_SEARCH_API_KEY=BSA...
# GHOST_TOOLS_WEB_DUCKDUCKGO_ENABLED=true

# ── Timezone ──────────────────────────────
# TZ=UTC

# ── ghost-bridge settings (add to existing Ghost .env) ──────────────────
BRIDGE_PORT=8765
BRIDGE_SECRET=pick_a_strong_secret_here

# Absolute paths (adjust username if not 'pi')
GHOST_DB_PATH=/home/pi/ghost/ghost.db
MEMORY_DIR=/home/pi/ghost/workspace/memory

# Optional: system prompt prepended to every request
GHOST_SYSTEM_PROMPT=You are Ghost, a sovereign AI on a Raspberry Pi. Be concise.

# Optional: comma-separated command prefixes to allow beyond the safe defaults
# ALLOWED_CMDS=python3,ollama,curl

# Optional: override screenshot command
# SCREENSHOT_CMD=scrot /tmp/ghost-bridge-screen.png
