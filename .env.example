# ── Ghost Configuration ─────────────────────────────────────────────────────
# Secrets and environment overrides. Structured config lives in config/config.json.
# ───────────────────────────────────────────────────────────────────────────

# ── Cloud LLM Provider Secrets ─────────────────────────────────────────────
# KIMI_API_KEY=
# OPENROUTER_API_KEY=sk-or-v1-xxx
# ANTHROPIC_API_KEY=sk-ant-xxx
# OPENAI_API_KEY=sk-xxx
# GEMINI_API_KEY=xxx
# GROQ_API_KEY=
# DEEPSEEK_API_KEY=
# ZHIPU_API_KEY=

# ── Chat Channel Secrets ───────────────────────────────────────────────────
# TELEGRAM_TOKEN=123456:ABC...
# TELEGRAM_USER_ID=
# DISCORD_BOT_TOKEN=xxx
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...
# LINE_CHANNEL_SECRET=xxx
# LINE_CHANNEL_ACCESS_TOKEN=xxx
# EMAIL_USERNAME=bot@example.com
# EMAIL_PASSWORD=xxx

# ── Web Search Secrets (Optional) ──────────────────────────────────────────
# FIRECRAWL_API_KEY=fc-xxx
# BRAVE_SEARCH_API_KEY=BSA...

# ── Ghost Internal API ─────────────────────────────────────────────────────
# Port where the bridge and remote clients connect
GHOST_API_PORT=8766
BRIDGE_SECRET=pick_a_strong_secret_here

# ── System Paths & Environment ─────────────────────────────────────────────
# GHOST_DIR=/var/ghost
# GHOST_CONFIG_DIR=
# GHOST_WORKSPACE_DIR=/var/lib/ghost/workspace  (runtime workspace; outside the install tree)
# GHOST_DB_PATH=/var/lib/ghost/workspace/ghost.db
# MEMORY_DIR=/var/lib/ghost/workspace/memory
# GHOST_RECOVERY_MODE=0
# GHOST_PROFILE=default
# GHOST_INSTANCE_ID=
# TZ=UTC

# ── Remote Bridge Commands ─────────────────────────────────────────────────
# ALLOWED_CMDS=python3,ollama,curl
# SCREENSHOT_CMD=scrot /tmp/ghost-bridge-screen.png

# ── Provider Overrides (Advanced) ──────────────────────────────────────────
# Each provider supports: API_KEY, API_BASE, PROXY, AUTH_METHOD, CONNECT_MODE
# GHOST_PROVIDERS_ANTHROPIC_API_KEY=
# GHOST_PROVIDERS_ANTHROPIC_API_BASE=
# GHOST_PROVIDERS_ANTHROPIC_PROXY=
# GHOST_PROVIDERS_OPENAI_API_KEY=
# GHOST_PROVIDERS_OPENAI_API_BASE=
# GHOST_PROVIDERS_OPENAI_PROXY=
# GHOST_PROVIDERS_OPENROUTER_API_KEY=
# GHOST_PROVIDERS_OPENROUTER_API_BASE=
# GHOST_PROVIDERS_GROQ_API_KEY=
# GHOST_PROVIDERS_DEEPSEEK_API_KEY=
# GHOST_PROVIDERS_GEMINI_API_KEY=
# GHOST_PROVIDERS_ZHIPU_API_KEY=
# GHOST_PROVIDERS_NVIDIA_API_KEY=
# GHOST_PROVIDERS_VLLM_API_BASE=http://localhost:8000
