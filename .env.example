# ── Ghost Configuration ────────────────────────────────────────────────────
# Use absolute path — tilde (~) does not expand in systemd or Go's os.Getenv
GHOST_AGENTS_DEFAULTS_WORKSPACE=/home/pi/ghost/workspace
GHOST_CONFIG_DIR=config

# ── LLM Provider ──────────────────────────────────────────────────────────
GHOST_AGENTS_DEFAULTS_PROVIDER=ollama
GHOST_AGENTS_DEFAULTS_MODEL=qwen3.5:0.8b
GHOST_AGENTS_DEFAULTS_EMBEDDING_MODEL=nomic-embed-text
GHOST_PROVIDERS_OLLAMA_API_BASE=http://localhost:11434

# ── Cloud LLM Providers (Optional) ────────────────────────────────────────
# KIMI_API_KEY=
# OPENROUTER_API_KEY=sk-or-v1-xxx
# ANTHROPIC_API_KEY=sk-ant-xxx
# OPENAI_API_KEY=sk-xxx
# GEMINI_API_KEY=xxx

# ── Chat Channels ──────────────────────────────────────────────────────────
# TELEGRAM_TOKEN=123456:ABC...
# TELEGRAM_USER_ID=
# DISCORD_BOT_TOKEN=xxx

# ── Web Search (optional) ──────────────────────────────────────────────────
# BRAVE_SEARCH_API_KEY=BSA...
# GHOST_TOOLS_WEB_DUCKDUCKGO_ENABLED=true

# ── Ghost API — one port for everything ───────────────────────────────────
# The Ghost process exposes a single API on this port for chat, history,
# memory, voice transcription, and Pi remote control.
GHOST_API_PORT=8766
BRIDGE_SECRET=pick_a_strong_secret_here

# ── Paths — set to absolute paths matching your username ──────────────────
# Default username is 'pi'. If yours differs, replace /home/pi with /home/<yourname>
# Ghost's install.sh and bridge's install.sh resolve these from $HOME automatically,
# so you only need to set these if your workspace is in a non-standard location.
# GHOST_DB_PATH=/home/pi/ghost/workspace/ghost.db
# MEMORY_DIR=/home/pi/ghost/workspace/memory

# ── Remote bridge optional overrides ──────────────────────────────────────
# ALLOWED_CMDS=python3,ollama,curl
# SCREENSHOT_CMD=scrot /tmp/ghost-bridge-screen.png

# ── Timezone ──────────────────────────────────────────────────────────────
# TZ=UTC
