# ── Ghost Pi Configuration ────────────────
TELEGRAM_TOKEN=
TELEGRAM_USER_ID=
KIMI_API_KEY=
GHOST_CONFIG_DIR=config

# ── LLM Provider (Alternatives) ───────────
# OPENROUTER_API_KEY=sk-or-v1-xxx
# ZHIPU_API_KEY=xxx
# ANTHROPIC_API_KEY=sk-ant-xxx
# OPENAI_API_KEY=sk-xxx
# GEMINI_API_KEY=xxx

# ── Local LLM (PicoLM) ───────────────────
# Linux/macOS:
# GHOST_PROVIDERS_PICOLM_BINARY=$HOME/.picolm/bin/picolm
# GHOST_PROVIDERS_PICOLM_MODEL=$HOME/.picolm/models/tinyllama-1.1b-chat-v1.0.Q4_K_M.gguf
# Windows:
# GHOST_PROVIDERS_PICOLM_BINARY=%USERPROFILE%\.picolm\bin\picolm.exe
# GHOST_PROVIDERS_PICOLM_MODEL=%USERPROFILE%\.picolm\models\tinyllama-1.1b-chat-v1.0.Q4_K_M.gguf

# ── Chat Channel ──────────────────────────
# TELEGRAM_BOT_TOKEN=123456:ABC...
# DISCORD_BOT_TOKEN=xxx
# LINE_CHANNEL_SECRET=xxx
# LINE_CHANNEL_ACCESS_TOKEN=xxx

# ── Web Search (optional) ────────────────
# BRAVE_SEARCH_API_KEY=BSA...

# ── Timezone ──────────────────────────────
# TZ=Asia/Tokyo
