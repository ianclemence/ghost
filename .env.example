# ── Ghost Configuration (Hybrid Architecture) ──────────────────────────────
# NOTE: Structure, models, routing, and tool logic is defined inside config/config.json.
# This file is strictly for Secrets and Environment Paths.
# ───────────────────────────────────────────────────────────────────────────

# ── Cloud LLM Providers (Secrets Only) ────────────────────────────────────
# KIMI_API_KEY=
# OPENROUTER_API_KEY=sk-or-v1-xxx
# ANTHROPIC_API_KEY=sk-ant-xxx
# OPENAI_API_KEY=sk-xxx
# GEMINI_API_KEY=xxx

# ── Chat Channels (Secrets Only) ──────────────────────────────────────────
# TELEGRAM_TOKEN=123456:ABC...
# DISCORD_BOT_TOKEN=xxx
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...
# LINE_CHANNEL_SECRET=xxx
# LINE_CHANNEL_ACCESS_TOKEN=xxx
# EMAIL_USERNAME=bot@example.com
# EMAIL_PASSWORD=xxx

# ── Web Search Secrets (Optional) ─────────────────────────────────────────
# BRAVE_SEARCH_API_KEY=BSA...

# ── Ghost Internal API ────────────────────────────────────────────────────
# Port where the bridge and remote clients connect
GHOST_API_PORT=8766
BRIDGE_SECRET=pick_a_strong_secret_here

# ── System Paths & Environment ────────────────────────────────────────────
# GHOST_DB_PATH=/home/pi/ghost/workspace/ghost.db
# MEMORY_DIR=/home/pi/ghost/workspace/memory
# TZ=UTC

# ── Remote bridge commands ────────────────────────────────────────────────
# ALLOWED_CMDS=python3,ollama,curl
# SCREENSHOT_CMD=scrot /tmp/ghost-bridge-screen.png
