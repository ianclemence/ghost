[Unit]
Description=Ghost First Boot Setup
After=network-online.target
Wants=network-online.target
ConditionPathExists=!__GHOST_DIR__/.setup-complete
Before=ghost.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=root
ExecStartPre=/usr/bin/sudo ufw allow 80/tcp
ExecStart=__BIN_DIR__/ghost-firstboot -port 80 -dir __GHOST_DIR__ -wait
ExecStartPost=/usr/bin/sudo ufw delete allow 80/tcp 2>/dev/null || true
ExecStartPost=/bin/bash -c 'systemctl daemon-reload && systemctl start ghost'

[Install]
WantedBy=multi-user.target
