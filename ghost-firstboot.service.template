[Unit]
Description=Ghost First Boot Wizard
After=network-online.target
Wants=network-online.target
ConditionPathExists=!__GHOST_DIR__/.setup-complete

[Service]
Type=simple
User=root
ExecStartPre=/usr/bin/sudo ufw allow 80/tcp
ExecStart=__BIN_DIR__/ghost-firstboot -port 80 -dir __GHOST_DIR__
ExecStartPost=/usr/bin/sudo ufw delete allow 80/tcp
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
