# ── Ghost Configuration ────────────────
GHOST_AGENTS_DEFAULTS_WORKSPACE=~/ghost/workspace
GHOST_CONFIG_DIR=config

# ── LLM Provider (Primary: Ollama) ──────
# Set Ollama as the default provider for Pi/Edge
GHOST_AGENTS_DEFAULTS_PROVIDER=moonshot
GHOST_AGENTS_DEFAULTS_MODEL=kimi-k2.5
GHOST_AGENTS_DEFAULTS_EMBEDDING_MODEL=nomic-embed-text
GHOST_PROVIDERS_OLLAMA_API_BASE=http://localhost:11434/v1

# ── Cloud LLM Providers (Existing) ──────
KIMI_API_KEY=sk-jjEfBticsyS5dx9HXcjd653x4OofHZYR64QZ2IBDdzPdMINT
