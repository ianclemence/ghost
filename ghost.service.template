[Unit]
Description=Ghost - your personal AI, running locally
After=network-online.target ghost-web.service ghost-speech.service
Wants=network-online.target
# An appliance must come back on its own. (These keys used to sit in [Service],
# where systemd ignores them; enforcing "3 in 5 minutes" would leave a Pod dead
# after one bad boot, so rate limiting is explicitly off and RestartSec paces it.)
StartLimitIntervalSec=0
ConditionPathExists=__GHOST_DIR__/.setup-complete

[Service]
Type=simple
User=__USER__
Group=__GROUP__
WorkingDirectory=__GHOST_DIR__
EnvironmentFile=__GHOST_DIR__/.env
Environment=GHOST_WORKSPACE_DIR=/var/lib/ghost/workspace
ExecStart=__BIN_DIR__/ghost serve
Restart=always
RestartSec=5

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=__GHOST_DIR__ /var/lib/ghost
PrivateTmp=true

# Resource ceiling. Browsers, installs and sandboxed code all run inside this
# service's cgroup, so one runaway tool must slow down (MemoryHigh throttles
# and reclaims) and then be killed (MemoryMax) before it can starve the Pod,
# the web console or SSH. Percentages follow the machine, 4 GB or 16 GB.
MemoryHigh=70%
MemoryMax=85%
TasksMax=4096

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ghost

[Install]
WantedBy=multi-user.target
