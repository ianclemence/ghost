[Unit]
Description=Ghost Pi - Sovereign AI Presence
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/ghost
ExecStart=/usr/local/bin/ghost gateway
Restart=always
RestartSec=5
Environment=Ghost_CONFIG_DIR=/home/pi/ghost/config
Environment=Ghost_WORKSPACE_DIR=/home/pi/ghost/workspace

[Install]
WantedBy=multi-user.target
