[Unit]
Description=Ghost Pi - Sovereign AI Presence
After=network.target

[Service]
Type=simple
User=ianclemence
WorkingDirectory=/home/ianclemence/ghost
EnvironmentFile=/home/ianclemence/ghost/.env
Environment=GHOST_WORKSPACE_DIR=/home/ianclemence/ghost/workspace
ExecStart=/home/ianclemence/.local/bin/ghost gateway
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target