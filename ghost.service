[Unit]
Description=Ghost Pi - Sovereign AI Presence
After=network.target

[Service]
Type=simple
User=%u
WorkingDirectory=%h/ghost
ExecStart=/usr/local/bin/ghost gateway
Restart=always
RestartSec=5
EnvironmentFile=%h/ghost/.env
Environment=GHOST_CONFIG_DIR=%h/ghost/config
Environment=GHOST_WORKSPACE_DIR=%h/ghost/workspace

[Install]
WantedBy=multi-user.target
