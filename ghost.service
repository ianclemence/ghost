[Unit]
Description=Ghost Pi - Sovereign AI Presence
After=network.target

[Service]
Type=simple
User=ianclemence
WorkingDirectory=/home/ianclemence/ghost
ExecStart=/usr/local/bin/ghost gateway
Restart=always
RestartSec=5
EnvironmentFile=/home/ianclemence/ghost/.env
Environment=GHOST_CONFIG_DIR=/home/ianclemence/ghost/config
Environment=GHOST_WORKSPACE_DIR=/home/ianclemence/ghost/workspace

[Install]
WantedBy=multi-user.target
